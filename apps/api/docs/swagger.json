                        }
                    },
                    "500": {
                        "description": "Failed to fetch movies",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/movies/search": {
            "get": {
                "description": "Search movies with various filters including genre, year, ratings, and more",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movies"
                ],
                "summary": "Search movies with filters",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Search query",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Comma-separated genre IDs",
                        "name": "genre_ids",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Minimum release year",
                        "name": "year_from",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Maximum release year",
                        "name": "year_to",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Minimum IMDB rating",
                        "name": "imdb_min",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Maximum IMDB rating",
                        "name": "imdb_max",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Minimum user rating",
                        "name": "user_rating_min",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Maximum user rating",
                        "name": "user_rating_max",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Minimum Rotten Tomatoes score",
                        "name": "rt_min",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Maximum Rotten Tomatoes score",
                        "name": "rt_max",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Minimum Metacritic score",
                        "name": "metacritic_min",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Maximum Metacritic score",
                        "name": "metacritic_max",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "title_asc",
                            "title_desc",
                            "release_date_asc",
                            "release_date_desc",
                            "imdb_rating_asc",
                            "imdb_rating_desc",
                            "user_rating_asc",
                            "user_rating_desc"
                        ],
                        "type": "string",
                        "description": "Sort field",
                        "name": "sort_by",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 20,
                        "description": "Results per page",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Page number",
                        "name": "page",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Search results",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/definitions/github_com_MassoudJavadi_filmophilia_api_internal_dto.AdvancedSearchResponse"
                            }
                        }
                    },
                    "500": {
                        "description": "Search failed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/movies/{movieId}/rating": {
