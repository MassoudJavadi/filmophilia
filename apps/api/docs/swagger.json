                    "application/json"
                ],
                "tags": [
                    "ratings"
                ],
                "summary": "Get my rating for a movie",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Movie ID",
                        "name": "movieId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User's rating",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/definitions/github_com_MassoudJavadi_filmophilia_api_internal_dto.RatingResponse"
